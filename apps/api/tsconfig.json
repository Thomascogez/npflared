{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"skipLibCheck": true,
		"lib": ["ESNext"],
		"types": ["@cloudflare/vitest-pool-workers", "node"],
		"jsx": "react-jsx",
		"jsxImportSource": "hono/jsx",
		"noUncheckedIndexedAccess": true
	},
	"exclude": ["node_modules", "dist", "admin"]
}
