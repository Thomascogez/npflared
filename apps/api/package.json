{
	"name": "@firestash/api",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"imports": {
		"#*": "./src/*.ts"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"deploy": "vite build && pnpm release",
		"release": "wrangler d1 migrations apply DB --remote && wrangler deploy",
		"generate-migrations": "drizzle-kit generate",
		"migrate:local": "npx wrangler d1 migrations apply DB",
		"migrate:prod": "npx wrangler d1 migrations apply DB --remote",
		"migrate-tokens:local": "node scripts/migrate-legacy-tokens.mjs",
		"migrate-tokens:prod": "node scripts/migrate-legacy-tokens.mjs --remote",
		"test:watch": "vitest watch",
		"test:single": "vitest run",
		"check-types": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.admin.json"
	},
	"dependencies": {
		"@hono/standard-validator": "^0.2.1",
		"@scalar/hono-api-reference": "^0.10.0",
		"@twinkleplop/bash": "^0.1.7",
		"@twinkleplop/json": "^0.1.7",
		"@twinkleplop/theme-github": "^0.2.4",
		"@twinkleplop/toml": "^0.1.7",
		"dompurify": "^3.4.17",
		"drizzle-orm": "^0.45.1",
		"hono": "^4.11.3",
		"hono-openapi": "^1.1.2",
		"marked": "^18.1.1",
		"semver-regex": "^4.0.5",
		"zod": "^4.3.5"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.64.0",
		"@cloudflare/vitest-pool-workers": "^0.12.1",
		"@fontsource-variable/source-sans-3": "^5.3.1",
		"@internationalized/date": "^3.12.0",
		"@lucide/svelte": "^1.61.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.2.4",
		"@tsconfig/svelte": "^5.0.8",
		"@types/node": "^25.0.6",
		"bits-ui": "^2.18.0",
		"cn": "^0.5.0",
		"drizzle-kit": "^0.31.4",
		"shadcn-svelte": "^1.7.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.2.4",
		"tw-animate-css": "^1.4.0",
		"vite": "^8.3.4",
		"vitest": "3.2.4",
		"wrangler": "^4.151.0"
	}
}
