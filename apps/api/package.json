{
	"name": "@npflared/api",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"imports": {
		"#*": "./src/*.ts",
		"#ui/*": "./src/ui/*.tsx"
	},
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"build:css": "tailwindcss -i src/styles.css -o public/styles.css",
		"deploy": "wrangler deploy --minify",
		"generate-migrations": "drizzle-kit generate",
		"migrate:local": "npx wrangler d1 migrations apply DB",
		"migrate:prod": "npx wrangler d1 migrations apply DB --remote",
		"test:watch": "vitest watch",
		"test:single": "vitest run",
		"check-types": "tsc --noEmit"
	},
	"dependencies": {
		"@hono/standard-validator": "^0.2.1",
		"@scalar/hono-api-reference": "^0.10.0",
		"drizzle-orm": "^0.45.1",
		"highlight.js": "^11.11.1",
		"hono": "^4.11.3",
		"hono-openapi": "^1.1.2",
		"marked": "^18.0.3",
		"semver-regex": "^4.0.5",
		"zod": "^4.3.5"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.36.4",
		"@cloudflare/vitest-pool-workers": "^0.12.1",
		"@hono/vite-build": "^1.11.1",
		"@tailwindcss/cli": "^4.3.0",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^25.0.6",
		"drizzle-kit": "^0.31.4",
		"tailwindcss": "^4.3.0",
		"vite": "^8.0.12",
		"vitest": "3.2.4",
		"wrangler": "^4.58.0"
	}
}
