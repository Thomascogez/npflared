{
	"extends": "@tsconfig/svelte/tsconfig.json",
	"compilerOptions": {
		"target": "ES2023",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"types": ["svelte", "vite/client"],
		"allowArbitraryExtensions": true,
		"noEmit": true,
		"moduleDetection": "force",
		"noUncheckedIndexedAccess": true,
		"paths": {
			"$lib": ["./admin/lib"],
			"$lib/*": ["./admin/lib/*"]
		}
	},
	"include": ["admin/**/*.ts", "admin/**/*.svelte"]
}
