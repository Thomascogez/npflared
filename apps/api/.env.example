# Deployment-specific values, applied to the worker configuration when building (`pnpm build`).
# Set them as build variables of your Workers Builds project, or copy this file to `.env.local`
# (ignored by git) to build and deploy from your machine. Unset values keep the placeholders of wrangler.toml.

# Worker name and custom domain. With a domain, the workers.dev URL is disabled.
FIRESTASH_WORKER_NAME=firestash
FIRESTASH_CUSTOM_DOMAIN=registry.example.com

# D1 database and R2 bucket, created beforehand in the account.
FIRESTASH_D1_DATABASE_NAME=firestash
FIRESTASH_D1_DATABASE_ID=00000000-0000-0000-0000-000000000000
FIRESTASH_R2_BUCKET_NAME=firestash

# Cloudflare Access application protecting /_/admin. These can also be set as worker secrets instead.
CF_ACCESS_TEAM_DOMAIN=my-team.cloudflareaccess.com
CF_ACCESS_AUD=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Registry used for packages that are not published here.
# FALLBACK_REGISTRY_ENDPOINT=https://registry.npmjs.org

# Address of the product documentation, linked from the usage page at the root of the registry.
# DOCS_URL=https://docs.example.com
